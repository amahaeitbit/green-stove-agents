# Copy to .env (git-ignored). Mock mode needs no key.
GREENSTOVE_LLM=mock                 # mock | crusoe
GREENSTOVE_LIVE_SPEND_OK=0          # must be 1 before any billable Crusoe call
# Export or paste the key exactly; keys can contain "$", so never wrap it in double quotes in a shell.
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
GREENSTOVE_MODEL=nvidia/Nemotron-3-Super-120B-A12B   # confirm the exact id with: python -m greenstove smoke --mode crusoe
GREENSTOVE_TEMPERATURE=0.2
GREENSTOVE_MAX_TOKENS=1024
GREENSTOVE_TIMEOUT_S=60
GREENSTOVE_MAX_CALLS_PER_RUN=8
GREENSTOVE_MAX_TOKENS_PER_RUN=30000
GREENSTOVE_DATA_DIR=data
# You.com Web Search for weather forecasts (gsa forecast --mode live); also needs GREENSTOVE_LIVE_SPEND_OK=1
YDC_API_KEY=
