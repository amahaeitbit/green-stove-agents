# Green-Stove inside a NemoClaw sandbox. Copy to /sandbox/gsa.env (writable) and fill in the keys
# yourself; never commit the filled file. run-in-sandbox.sh sources it. No secrets in this template.

# --- layout (read-only repo mount, writable data) ---
GSA_REPO=/sandbox/green-stove-agents        # repo; read-only when mounted with onboard --host-mount
GSA_VENV=/sandbox/gsa-venv                  # Python env for our dependencies (writable)
GREENSTOVE_DATA_DIR=/sandbox/gsa-data       # evidence, brain workspace, events, alerts (writable)
GREENSTOVE_FROZEN_DIR=frozen                # frozen brain snapshot inside the repo (read-only); guardrail probe target

# --- model ---
GREENSTOVE_LLM=crusoe                       # mock works with no key and no network
GREENSTOVE_LIVE_SPEND_OK=1                  # must be 1 before any billable call
GREENSTOVE_MODEL=nvidia/Nemotron-3-Super-120B-A12B   # pin the exact id from `gsa models`; same id as NEMOCLAW_MODEL
# Option A (direct, simplest): the key lives in this file inside the sandbox.
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
CRUSOE_API_KEY=
# Option B (gateway, UNVERIFIED with our client): key stays in the NemoClaw gateway from onboarding.
# CRUSOE_BASE_URL=https://inference.local/v1
# CRUSOE_API_KEY=placeholder-gateway-injects-key-0000

# --- forecast search (optional; mock search works without it) ---
YDC_API_KEY=

# --- runner ---
GREENSTOVE_RUNNER_MAX_CALLS_PER_DAY=20
GSA_RUNNER_INTERVAL=30
